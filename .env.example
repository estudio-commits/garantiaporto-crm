# Without these values, only the explicitly labelled synthetic demo is available.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
CRM_WEBHOOK_SECRET=
# Enable only in isolated development/staging after applying migrations.
CRM_INTEGRATION_ENABLED=false
# WhatsApp Cloud API (docs/WHATSAPP.md). Server only; keep WHATSAPP_ENABLED=false until tested.
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Protects /api/whatsapp/worker (Vercel Cron sends it automatically).
CRON_SECRET=
